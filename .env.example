# Copie este arquivo para .env.local e preencha. Na Vercel, as mesmas variáveis
# ficam em Settings > Environment Variables. Sem banco, o app guarda tudo na memória.

# URL pública do site, usada nas tags Open Graph, no robots.txt e no sitemap.xml (sem barra no final).
NEXT_PUBLIC_SITE_URL=https://dn-pede-ai.vercel.app

# Banco Postgres (Neon). Em desenvolvimento, use a URL da branch "dev", nunca a de produção.
# A versão sem pooler é usada pelas migrações (`pnpm db:migrate`); se faltar, vale a DATABASE_URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# `postgres` para o `pnpm dev` usar o banco acima. Sem ela, fora da Vercel, os dados ficam na memória.
PEDE_AI_STORE=

# Banco só dos testes do store no Postgres (outra branch do Neon): cada teste apaga as tabelas.
TEST_DATABASE_URL=

# Chave que assina os cookies do cliente e da equipe. Gere com `openssl rand -base64 32`
# e use uma diferente em cada ambiente. Obrigatória na Vercel.
SESSION_SECRET=

# Better Auth. O segredo assina as sessões das contas (sem ele, vale a SESSION_SECRET):
# também um diferente por ambiente. No computador, o login aceita localhost em qualquer porta.
BETTER_AUTH_SECRET=

# Senha da rotina diária de privacidade (/api/cron/privacy), igual à dos segredos do GitHub.
CRON_SECRET=

# Avisos no celular da equipe: `pnpm exec web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
